{
  "sourceLanguage": "en",
  "strings": {
    "Couldn't reach the party. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo llegar a la fiesta. Revisa tu conexión e inténtalo de nuevo."
          }
        }
      }
    },
    "That isn't an Instagram, TikTok or YouTube link.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no es un enlace de Instagram, TikTok o YouTube."
          }
        }
      }
    },
    "Open ScrollParty and join a party first.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre ScrollParty y únete primero a una fiesta."
          }
        }
      }
    },
    "Sharing isn't available in this build.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir no está disponible en esta versión."
          }
        }
      }
    },
    "The party has already started.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiesta ya ha empezado."
