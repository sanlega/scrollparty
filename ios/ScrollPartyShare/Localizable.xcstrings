        }
      }
    },
    "Couldn't add the reel. The party may have changed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo añadir el reel. Puede que la fiesta haya cambiado."
          }
        }
      }
    },
    "Your session expired. Open ScrollParty and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión ha caducado. Abre ScrollParty e inténtalo de nuevo."
          }
        }
      }
    },
    "That party no longer exists.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa fiesta ya no existe."
          }
