rules_version = '2';

// Contrato de datos: docs/decisiones/2026-11-04-modelo-de-datos.md
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{code} {
      function group() { return get(/databases/$(database)/documents/groups/$(code)).data; }
      function isMember() { return exists(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid)); }
      function isAdmin() { return group().adminId == request.auth.uid; }

      // get por código para poder unirse; list prohibido para no enumerar grupos.
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.status == 'collecting';
      allow update: if isAdmin() && request.resource.data.adminId == resource.data.adminId;

      match /members/{uid} {
        allow read: if isMember() || request.auth.uid == uid;
        allow create, update: if request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.count is int
          && (!('photo' in request.resource.data)
            || (request.resource.data.photo is string && request.resource.data.photo.size() <= 40000));
      }

      // Nadie ve los enlaces de otros hasta la sesión; entonces solo el anfitrión.
      match /links/{id} {
        allow read: if resource.data.authorId == request.auth.uid
          || (isAdmin() && group().status != 'collecting');
        allow create: if isMember()
          && group().status == 'collecting'
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.url is string
          && request.resource.data.url.matches('https://(([a-z]+[.])?(instagram|tiktok|youtube)[.]com|youtu[.]be)/.+')
          && request.resource.data.url.size() <= 500
          && (!('clue' in request.resource.data)
            || (request.resource.data.clue is string && request.resource.data.clue.size() <= 80));
        allow delete: if resource.data.authorId == request.auth.uid && group().status == 'collecting';
      }

      match /rounds/{id} {
        allow read: if isMember();
        allow create: if isAdmin() && request.resource.data.authorId == null;
        allow delete: if isAdmin();
        allow update: if (isAdmin()
            && request.resource.data.url == resource.data.url
            && request.resource.data.votes == resource.data.votes
            && request.resource.data.get('reactions', {}) == resource.data.get('reactions', {}))
          || (isMember()
            && resource.data.authorId == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
            && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.votes[request.auth.uid] is string)
          || (isMember()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.reactions[request.auth.uid] in ['laugh', 'skull', 'fire', 'sleep']);
      }
    }
  }
}
